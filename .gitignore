!/panorama/
!/panorama/WORKFLOW.md
!/panorama/FOOTBALL_WORKFLOW.md
!/panorama/presets/
!/panorama/presets/default.json
!/panorama/profiles/
!/panorama/profiles/football.json
!/panorama/templates/
!/panorama/templates/job.json
!/panorama/templates/match.json
!/panorama/templates/video-description.txt
!/panorama/templates/youtube-description.txt
!/panorama/tools/
