{
  "id": "football-smooth-v1",
  "purpose": "Football ball-following editing guidelines.",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "aspect": "16:9",
    "video_codec": "h264",
    "video_bitrate": 14000000,
    "audio_codec": "aac",
    "audio_bitrate": 192000,
    "source_audio": true,
    "faststart": true,
    "split": "quarter",
    "black_padding": false,
    "overlays": []
  },
  "camera": {
    "target": "ball",
    "continuous_pan_and_zoom": true,
    "follow_fast_passes_promptly": true,
    "pre_pan_before_release": false,
    "temporary_zoom_out_for_edges": true,
    "check_full_ball_bbox": true,
    "reset_each_quarter": true
  },
  "trim_start_seconds": null,
  "team_name": null,
  "title_template": "[{team_name}] {YYYY}.{MM}.{DD} - {segment_label}",
  "description_field_order": [
    "일자",
    "장소",
    "경기",
    "영상",
    "",
    "hashtags"
  ],
  "note": "Observe the ball and segment boundaries on the full panorama. Measure camera timing and projection when stitching camera originals."
}
